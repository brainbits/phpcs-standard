<?xml version="1.0"?>
<ruleset name="brainbits-phpcs-standard">
    <description>The brainbits coding standard.</description>

	<file>Brainbits</file>
	<file>tests</file>

	<exclude-pattern>tests/*/input/*</exclude-pattern>
	<exclude-pattern>tests/*/fixture/*</exclude-pattern>

	<arg name="basepath" value="."/>
	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<rule ref="Brainbits" />
</ruleset>
